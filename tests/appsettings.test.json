{
  "$schema": "http://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Ansi",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithProperty"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=senseik_test;User Id=postgres;Password=postgres;Port=5432;Application Name=SenseIK.Tests"
  },
  "SenseOptions": {
    "ApplicationName": "SenseİK Tests",
    "ApiVersion": "v1.0-test",
    "Environment": "Test",
    "IsProduction": false
  },
  "JwtSettings": {
    "Secret": "test-secret-key-for-testing-only-do-not-use-in-production-min-32-chars",
    "Issuer": "https://auth.test",
    "Audience": "https://api.test",
    "ExpirationMinutes": 60
  },
  "HealthChecks": {
    "Enabled": true
  },
  "Hangfire": {
    "Enabled": false,
    "DashboardPath": "/hangfire"
  },
  "MinIO": {
    "Enabled": false,
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "senseik-test",
    "UseSSL": false
  },
  "Redis": {
    "Enabled": false,
    "Configuration": "localhost:6379"
  },
  "AllowedHosts": "*"
}
