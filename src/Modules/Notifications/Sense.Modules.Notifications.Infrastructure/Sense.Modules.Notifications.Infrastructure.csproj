<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sense.Modules.Notifications.Application/Sense.Modules.Notifications.Application.csproj" />
    <ProjectReference Include="../../../Shared/Sense.Shared.Infrastructure/Sense.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scriban" />
    <!-- Design-time only, for `dotnet ef migrations add`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- {key}.{channel}.{lang}.sbn, _layout.email.{lang}.sbn, labels.{lang}.json; resource name = Templates/<file>.
         WithCulture=false: otherwise MSBuild reads the ".tr"/".en"/".de" part as a culture and moves the file into a
         satellite assembly, so GetManifestResourceStream on the main assembly finds nothing. -->
    <EmbeddedResource Include="Templates/**/*" LogicalName="Templates/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
