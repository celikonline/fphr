<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject | html.escape }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Segoe UI,Arial,sans-serif;color:#18181b">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:24px">
<p style="margin:0 0 16px;font-weight:600;color:#4f46e5">SenseİK</p>
{{ content }}
<hr style="border:none;border-top:1px solid #e4e4e7;margin:24px 0 12px">
<p style="margin:0;font-size:12px;color:#71717a">This e-mail was sent automatically by SenseİK. You can choose which notifications you receive in your <a href="{{ settings_url | html.escape }}" style="color:#71717a">notification settings</a>.</p>
</div>
</body>
</html>
