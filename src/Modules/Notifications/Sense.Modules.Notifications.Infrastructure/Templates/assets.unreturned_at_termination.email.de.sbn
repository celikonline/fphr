{{- subject = "Nicht zurückgegebene Ausrüstung: " + employee_name -}}
<p>Hallo {{ recipient_name | html.escape }},</p>
<p><strong>{{ employee_name | html.escape }}</strong> hat das Unternehmen verlassen, ohne die Ausrüstung zurückzugeben.</p>
{{~ if action_url ~}}
{{ button "Ausrüstung ansehen" action_url }}
{{~ end ~}}
