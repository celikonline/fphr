{{-
if is_high_priority == "true"
  subject = "[Wichtig] Neue Ankündigung: " + announcement_title
else
  subject = "Neue Ankündigung: " + announcement_title
end
-}}
<p>Hallo {{ recipient_name | html.escape }},</p>
<p><strong>{{ announcement_title | html.escape }}</strong></p>
{{~ if announcement_excerpt ~}}
<p>{{ announcement_excerpt | html.escape }}</p>
{{~ end ~}}
{{~ if action_url ~}}
{{ button "Ankündigung lesen" action_url }}
{{~ end ~}}
