{{- subject = "Unreturned equipment: " + employee_name -}}
{{- if asset_name != null && asset_name != ""; subject = "Unreturned equipment: " + employee_name + " (" + asset_name + ")"; end -}}
<p>Hi {{ recipient_name | html.escape }},</p>
<p><strong>{{ employee_name | html.escape }}</strong> has left, but {{ if asset_name != null && asset_name != "" }}{{ asset_name | html.escape }} was not returned{{ else }}has equipment that was not returned{{ end }}.</p>
{{~ if action_url ~}}
{{ button "View equipment" action_url }}
{{~ end ~}}
