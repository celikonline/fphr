{
  "ConnectionStrings": {
    "Database": "Host=127.0.0.1;Port=5432;Database=senseik;Username=postgres;Password=postgres;Include Error Detail=true",
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "Application": { "Name": "Sense.Api" },
  "Auth": {
    "Issuer": "senseik",
    "Audience": "senseik-api",
    "KeyId": "sense-dev",
    "ClockSkewSeconds": 30,
    "HubPathPrefix": "/hubs"
  },
  "Identity": {
    "TrialDays": 15,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "InvitationValidityHours": 72,
    "PasswordResetValidityMinutes": 60,
    "MinPasswordLength": 10,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MfaTokenMinutes": 5,
    "TrustedDeviceDays": 30,
    "DefaultLanguage": "tr",
    "DefaultLocale": "tr-TR",
    "DefaultTimeZone": "Europe/Istanbul",
    "AllowSelfRegistration": true
  },
  "Localization": {
    "DefaultCulture": "tr-TR",
    "SupportedCultures": [ "tr-TR", "en-US" ],
    "ResourcesPath": "Resources"
  },
  "Paging": { "DefaultPageSize": 20, "MaxPageSize": 200, "SyncExportRowLimit": 5000 },
  "Caching": { "DefaultExpirationMinutes": 5, "LocalExpirationSeconds": 30, "PermissionExpirationMinutes": 10, "KeyPrefixGlobal": "global" },
  "Outbox": { "BatchSize": 50, "MaxAttempts": 10, "BaseBackoffSeconds": 5, "MaxBackoffSeconds": 3600, "PollingIntervalSeconds": 2, "RetentionDays": 30 },
  "Diagnostics": { "SlowRequestThresholdMs": 500, "ActivitySourceName": "Sense.Dispatcher" },
  "ProblemDetails": { "TypeBaseUrl": "https://docs.senseik.com/errors/", "IncludeExceptionDetails": false },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "C:/Users/ozgur.celik/algosense/data/files",
    "PublicBaseUrl": "https://localhost:5001/files"
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "SenseİK",
    "FromAddress": "no-reply@senseik.local",
    "Smtp": { "Host": "127.0.0.1", "Port": 1025, "UseSsl": false }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000",
    "InviteAcceptPath": "/invite/{token}",
    "PasswordResetPath": "/reset-password/{token}",
    "LoginPath": "/login?company={slug}"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [ { "Name": "Console" } ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
