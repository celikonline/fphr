{
  "name": "senseik",
  "version": "0.1.0",
  "description": "Algosense HR/Payroll SaaS Platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format",
    "type-check": "pnpm --filter web type-check",
    "test": "pnpm --filter web test",
    "generate:api-client": "pnpm --filter @senseik/api-client generate"
  },
  "workspaces": [
    "web",
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "web/**/*.{ts,tsx}": ["pnpm --dir web exec eslint --fix"],
    "apps/senseik-mobile/**/*.{ts,tsx}": ["eslint --fix"],
    "src/**/*.cs": ["dotnet format Sense.slnx --include"]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.0.0"
  }
}
