# infra/docker-compose.yml için ortam değişkenleri (kopyalayın: cp .env.example .env)
# Port kalıbı: host'a yayınlanan her port "standart port + 10000" (örn. Postgres 5432 -> 15432);
# bu makinede zaten kurulu olabilecek aynı servislerin standart portlarıyla çakışmayı önler.
POSTGRES_USER=sense
POSTGRES_PASSWORD=sense
POSTGRES_DB=senseik
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
RABBITMQ_USER=sense
RABBITMQ_PASSWORD=sense
RABBITMQ_PORT=15672
RABBITMQ_UI_PORT=25672
SEQ_PORT=15341

# Observability (profile "obs"): Jaeger (izler), Prometheus (metrikler), Loki (loglar), Grafana (dashboard'lar).
# Bkz. docs/observability.md. Grafana varsayılan olarak 13001'dedir (13000 web uygulamasına ayrılmıştır).
JAEGER_UI_PORT=26686
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
PROMETHEUS_PORT=19090
LOKI_PORT=13100
GRAFANA_PORT=13001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Sentry: boş bırakılırsa devre dışıdır (local dev'de varsayılan budur). Ayarlarsanız Sense.Api başlangıçta
# otomatik olarak Sentry'yi etkinleştirir (bkz. docs/observability.md).
SENTRY_DSN=

# docker-compose.yml (repo root) için ek ortam değişkenleri - api/web'i de container olarak
# çalıştıran tam-stack local dev kurulumu. Bkz. docs/ci-cd.md.
API_PORT=18080
WEB_PORT=13000
SEED_PROFILE=demo

# Süper admin (platform hesabı) - yeni şirket (kiracı) açabilen tek hesap. İkisi de dolu ise API açılışında
# "platform" kiracısı + hesap idempotent oluşturulur; boşsa atlanır. Parola en az 10 karakter ve güçlü olmalı.
# Bu dosyaya gerçek parola YAZMAYIN; kendi .env dosyanıza (git'e girmez) yazın.
PLATFORM_SUPERADMIN_EMAIL=
PLATFORM_SUPERADMIN_PASSWORD=

# Terminal kimlik (kart/PIN) özetleri için sunucu tarafı pepper (Attendance:Terminals:CredentialPepper, en az 32 karakter).
# Zorunlu değil; terminal kimlikleri için gerekli: boşsa API açılır (başlangıçta uyarı), yalnız kimlik işlemleri 503 döner.
# Değer üretin (ör. `openssl rand -base64 48`) ve YALNIZ kendi .env dosyanıza yazın; değiştirilirse kayıtlı tüm terminal
# kimlikleri yeniden tanımlanmalıdır.
ATTENDANCE_TERMINAL_CREDENTIAL_PEPPER=
