        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"SenseIK.Api\", deployment_environment=~\"$env\"} |~ \"(?i)${search:regex}\" | detected_level=~\"$level\" | CorrelationId=~\"${correlation_id:regex}.*\" | TenantId=~\"${tenant_id:regex}.*\" | UserId=~\"${user_id:regex}.*\" | ClientApp=~\"${client_app:regex}.*\" [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
