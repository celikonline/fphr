{
  "uid": "senseik-logs",
  "title": "SenseİK · Loglar",
  "description": "Sense.Api yapılandırılmış logları (Serilog → OTLP → Loki). Correlation id, kiracı, kullanıcı, istemci ve serbest metin ile filtrelenir; log satırındaki TraceID bağlantısı izi Jaeger'de açar.",
  "tags": [
    "senseik",
    "logs",
    "loki"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "senseik"
      ],
      "asDropdown": true,
      "title": "SenseİK",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Ortam",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "deployment_environment",
          "stream": "{service_name=\"SenseIK.Api\"}",
          "refId": "env"
        },
        "definition": "label_values({service_name=\"SenseIK.Api\"}, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Seviye",
        "type": "custom",
        "query": "fatal,critical,error,warn,info,debug,trace",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "correlation_id",
        "label": "Correlation ID",
        "type": "textbox",
        "query": "",
        "description": "X-Correlation-Id (önek araması).",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "tenant_id",
        "label": "Tenant ID",
        "type": "textbox",
        "query": "",
        "description": "Kiracı GUID'i (önek araması).",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "user_id",
        "label": "User ID",
        "type": "textbox",
        "query": "",
        "description": "Kullanıcı GUID'i (önek araması).",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "client_app",
        "label": "İstemci",
        "type": "textbox",
        "query": "",
        "description": "X-Client-App: web, mobile, integration…",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Metin ara",
        "type": "textbox",
        "query": "",
        "description": "Log mesajında büyük/küçük harfe duyarsız serbest metin.",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
