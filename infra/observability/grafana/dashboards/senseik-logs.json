      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (detected_level, message_template_text, exception_type) (count_over_time({service_name=\"SenseIK.Api\", deployment_environment=~\"$env\"} |~ \"(?i)${search:regex}\" | CorrelationId=~\"${correlation_id:regex}.*\" | TenantId=~\"${tenant_id:regex}.*\" | UserId=~\"${user_id:regex}.*\" | ClientApp=~\"${client_app:regex}.*\" | detected_level=~\"error|fatal|critical|warn\" [$__range])))",
