  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"senseik-api\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"senseik-api\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
