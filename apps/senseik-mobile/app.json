{
  "expo": {
    "name": "SenseİK Mobile",
    "slug": "senseik-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.algosense.senseik",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.algosense.senseik",
      "versionCode": 1,
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-camera",
        { "cameraPermission": "Lokasyon girişindeki QR kodu okutmak için kamera erişimi gerekir." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Lokasyon geofence doğrulaması için konumunuz kullanılır." }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "senseik-mobile"
      }
    },
    "scheme": "senseik"
  }
}
