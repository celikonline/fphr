{
  "expo": {
    "name": "Sense HR",
    "slug": "senseik-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.algosense.senseik",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0E0033"
      },
      "package": "com.algosense.senseik",
      "versionCode": 1,
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Lokasyon girişindeki QR kodu okutmak için kamera erişimi gerekir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasyon geofence doğrulaması için konumunuz kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Belge eklemek için fotoğraf galerinize erişim gerekir.",
          "cameraPermission": "Belge fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E0033"
        }
      ],
      "./plugins/withAndroidBuildFixes.js",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "senseik-mobile"
      }
    },
    "scheme": "senseik"
  }
}
